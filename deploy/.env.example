# =====================================================================
#  TerraForge · 环境变量样例
#  复制为 .env 后按需修改；Docker 部署会通过 env_file 自动加载
# =====================================================================

# ---- 运行端口 ----
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ---- 数据库（MySQL 示例）----
# SQLite: DATABASE_URL=sqlite:///./data/terraforge.db
# MySQL : DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/terraforge?charset=utf8mb4
DATABASE_URL=sqlite:///./data/terraforge.db

# ---- 向量库 ----
# local : 零依赖、Numpy + Pickle（默认）
# milvus: 生产级向量库
VECTOR_BACKEND=local
MILVUS_HOST=
MILVUS_PORT=19530

# ---- LLM / Embedding / Rerank ----
# LLM_PROVIDER: mock | openai | azure | qwen | zhipu ...
# EMBEDDING_PROVIDER: hash | openai | bge | m3e
# RERANK_PROVIDER:
#   cross_encoder_local : 本地 CrossEncoder 风格重排（向量交互+词面，零依赖，默认）
#   cross_encoder_api   : 远程 bge-reranker 类 HTTP 服务（需 RERANK_BASE_URL）
#   rule                : 纯规则重排（兜底）
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=hash
RERANK_PROVIDER=cross_encoder_local
RERANK_TIMEOUT=30
RERANK_BASE_URL=
RERANK_API_KEY=

# Intent Agent（Sprint2 查询意图路由）
# INTENT_AGENT_ENABLED=1 时用 LLM 做结构化意图分类（需 OPENAI_API_KEY），否则规则兜底
INTENT_AGENT_ENABLED=1
# INTENT_OUT_OF_SCOPE=1 时把"与工程无关"的问题标记为越域（不强行检索）
INTENT_OUT_OF_SCOPE=1

# OpenAI 兼容（OpenAI / DeepSeek / Moonshot / 通义千问 OpenAI 模式）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
RERANK_MODEL=bge-reranker-v2-m3

# ---- 检索参数 ----
RETRIEVAL_TOP_K=20
RERANK_TOP_N=6
HYBRID_VECTOR_WEIGHT=0.6
HYBRID_BM25_WEIGHT=0.4
RRF_K=60

# ---- 置信度阈值 ----
CONFIDENCE_HIGH=0.75
CONFIDENCE_LOW=0.45

# ---- 跨域 ----
CORS_ORIGINS=*

# ---- Redis 多级缓存 L2（Sprint1）----
# REDIS_ENABLED=1 时开启 L2 缓存（L1 内存始终启用，L3 回源兜底）。
# Docker 部署默认连 redis 服务；裸机/虚拟机部署若未起 redis 可设为 0。
REDIS_ENABLED=0
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# ---- Docker Compose 端口 ----
# 默认 8001 以避开同机 KnowForge 已占用的 8000。
TERRAFORGE_PORT=8001
NGINX_PORT=80