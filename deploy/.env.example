# =====================================================================
#  TerraForge · 环境变量样例
#  复制为 .env 后按需修改；Docker 部署会通过 env_file 自动加载
# =====================================================================

# ---- 运行端口 ----
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ---- 数据库（MySQL 示例）----
# SQLite: DATABASE_URL=sqlite:///./data/terraforge.db
# MySQL : DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/terraforge?charset=utf8mb4
DATABASE_URL=sqlite:///./data/terraforge.db

# ---- 向量库 ----
# local : 零依赖、Numpy + Pickle（默认）
# milvus: 生产级向量库
VECTOR_BACKEND=local
MILVUS_HOST=
MILVUS_PORT=19530

# ---- LLM / Embedding / Rerank ----
# LLM_PROVIDER: mock | openai | azure | qwen | zhipu ...
# EMBEDDING_PROVIDER: hash | openai | bge | m3e
# RERANK_PROVIDER: rule | bge | cross-encoder
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=hash
RERANK_PROVIDER=rule

# OpenAI 兼容（OpenAI / DeepSeek / Moonshot / 通义千问 OpenAI 模式）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
RERANK_MODEL=bge-reranker-base

# ---- 检索参数 ----
RETRIEVAL_TOP_K=20
RERANK_TOP_N=6
HYBRID_VECTOR_WEIGHT=0.6
HYBRID_BM25_WEIGHT=0.4
RRF_K=60

# ---- 置信度阈值 ----
CONFIDENCE_HIGH=0.75
CONFIDENCE_LOW=0.45

# ---- 跨域 ----
CORS_ORIGINS=*