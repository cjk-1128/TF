# TerraForge 运行环境变量示例
# 用法：复制为同目录 .env 后按需修改（docker compose 通过 env_file 注入；pydantic-settings 也会读取）。
# 注意：docker-compose.yml 的 `environment` 块会覆盖本文件同名项。Phase 1 的 MySQL/Milvus/Redis
#       已在 compose 的 environment 中硬编码（经 host.docker.internal 访问宿主 KnowForge 容器底座）。
#       本文件作为"可读的配置参考 + 回退开关"。
# 容器内由 config.py 将 DATA/LOG/VECTOR 默认指向 /app 下，与 docker-compose.yml 卷挂载一致。

APP_NAME=TerraForge 土木工程智能知识平台
DEBUG=false

# ===== 数据库 =====
# Phase 1 生产（复用 KnowForge MySQL 容器，新建独立库 terraforge）：
# 注意：pymysql 不接受 allow_public_key_retrieval 参数，请勿带该后缀。
DATABASE_URL=mysql+pymysql://root:root123@host.docker.internal:13307/terraforge?charset=utf8mb4
# 回退到 Phase 0 零依赖 SQLite（容器卷持久化）：
# DATABASE_URL=sqlite:////app/data/terraforge.db

# ===== 向量库 =====
# Phase 1 生产（复用 KnowForge Milvus 容器，tf_ 前缀集合隔离）：
VECTOR_BACKEND=milvus
MILVUS_HOST=host.docker.internal
MILVUS_PORT=19530
MILVUS_COLLECTION=tf_chunks
MILVUS_INDEX_TYPE=HNSW
MILVUS_METRIC_TYPE=COSINE
# 回退到本地轻量向量库（零依赖）：
# VECTOR_BACKEND=local
LOCAL_VECTOR_DIR=/app/vectorstore

# ===== 检索 / 生成 provider =====
# Phase 1 仍用 hash（零依赖、可复现 1024 维向量）；Phase 2/3 再切真实 embedding + LLM。
EMBEDDING_PROVIDER=hash
EMBEDDING_DIM=1024
LLM_PROVIDER=mock

# ===== Redis（Phase 1 启用 L2 缓存；DB 1 与 KnowForge 隔离）=====
REDIS_ENABLED=true
REDIS_URL=redis://host.docker.internal:6379/1
# 回退（关闭缓存，仅 L1 内存）：
# REDIS_ENABLED=false
# REDIS_URL=redis://localhost:6379/0

# ===== 缓存 TTL 与答案缓存（多级缓存 L1 内存 + L2 Redis）=====
# L1/L2 通用条目 TTL（秒）
CACHE_TTL_SECONDS=3600
# 答案（管线结果）缓存：首轮完全相同的提问直接复用上次计算结果，跳过全链路 + LLM。
# 多轮对话（带历史）不参与，避免上下文串缓存。关闭则仅检索结果缓存生效。
CACHE_ANSWER_ENABLED=true
CACHE_ANSWER_TTL=3600

# ===== 多租户 / 鉴权 =====
RBAC_ENABLED=true
BOOTSTRAP_API_KEY=tf-admin-seed-key
DEFAULT_TENANT_ID=default

# ===== 日志 =====
LOG_LEVEL=INFO
