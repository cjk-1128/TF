# TerraForge 运行环境变量示例
# 用法：复制为同目录 .env 后按需修改（docker compose 通过 env_file 注入；pydantic-settings 也会读取）。
# 容器内由 config.py 将 DATA/LOG/VECTOR 默认指向 /app 下，与 docker-compose.yml 卷挂载一致。

APP_NAME=TerraForge 土木工程智能知识平台
DEBUG=false

# 数据库：Phase 0 默认 SQLite（容器卷持久化）；
# Phase 1 切换为 MySQL（复用 KnowForge 容器）示例：
#   DATABASE_URL=mysql+pymysql://terraforge:terraforge@192.168.88.100:13307/terraforge
DATABASE_URL=sqlite:////app/data/terraforge.db

# 向量库：local（内置轻量，零依赖）；milvus（需 Milvus 服务）
VECTOR_BACKEND=local
LOCAL_VECTOR_DIR=/app/vectorstore

# 检索 / 生成 provider（Phase 2/3 接入真实模型）
EMBEDDING_PROVIDER=hash
LLM_PROVIDER=mock

# Redis（Phase 3 启用缓存/限流）
REDIS_ENABLED=false
REDIS_URL=redis://redis:6379/0

# 多租户 / 鉴权
RBAC_ENABLED=true
BOOTSTRAP_API_KEY=tf-admin-seed-key
DEFAULT_TENANT_ID=default

# 日志
LOG_LEVEL=INFO
